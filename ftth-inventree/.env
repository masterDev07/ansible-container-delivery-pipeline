# --- KONFIGURASI UMUM INVENTREE ---
# Ganti dengan IP atau Domain Anda (misal: https://perusahaan.com)
INVENTREE_SITE_URL=https://192.168.43.165:5234

# Ubah nilai SECRET_KEY dengan string acak panjang untuk keamanan produksi
INVENTREE_SECRET_KEY=inventree

# Set FALSE untuk server produksi agar log error tidak bocor ke publik
INVENTREE_DEBUG=False
INVENTREE_LOG_LEVEL=INFO

# --- DIREKTORI DATA PERSISTEN ---
# Lokasi folder di komputer host tempat menyimpan file/media/database
COMPOSE_PROJECT_NAME=ftth-inventree
INVENTREE_EXT_VOLUME=./data

# --- KONFIGURASI DATABASE (POSTGRESQL) ---
INVENTREE_DB_ENGINE=postgresql
INVENTREE_DB_NAME=inventree
INVENTREE_DB_USER=inventree
INVENTREE_DB_PASSWORD=inventree
INVENTREE_DB_HOST=inventree-db
INVENTREE_DB_PORT=5432

# --- KONFIGURASI CACHE (REDIS) ---
INVENTREE_CACHE_HOST=inventree-cache
INVENTREE_CACHE_PORT=6379

# UI REACT
INVENTREE_EXPERIMENTAL_REACT_FRONTEND=True
