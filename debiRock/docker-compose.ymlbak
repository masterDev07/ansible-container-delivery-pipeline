services:
  # ==========================================
  # 5 SERVER DEBIAN (Node 1 - 5)
  # ==========================================
  debian1:
    image: debian:12-slim
    container_name: deb-node-01
    tty: true
    stdin_open: true
    command: ["sleep", "infinity"]
    environment:
      - http_proxy=http://192.168.43.1:44355/
      - https_proxy=https://192.168.43.1:44355/
      - HTTP_PROXY=http://192.168.43.1:44355/
      - HTTPS_PROXY=https://192.168.43.1:44355/
    networks:
      - ansible_net

